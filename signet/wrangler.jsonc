{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signet",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "signet"
    }
  ]
}
